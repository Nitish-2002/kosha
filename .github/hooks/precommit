 
#!/usr/bin/env bash
REPO_ROOT="$(git rev-parse --show-toplevel)"
echo "Running Flyingduck security tests on ${REPO_ROOT}"
# Run Duck Defender (no --entrypoint override needed)
docker run --pull=always -v "${REPO_ROOT}:/src" --entrypoint /bin/bash flyingduckio/duckdefender:latest -c "duckdefender pre-commit --sca --secrets --sast"
EXIT_CODE=$?
 
if [ $EXIT_CODE -eq 0 ]; then
    echo "Git commit passed all Flyingduck security tests successfully (exit code $EXIT_CODE)"
elif [ $EXIT_CODE -eq 1 ]; then
    echo "Git commit failed due to security issues detected by Flyingduck (exit code $EXIT_CODE)"
fi
 
exit $EXIT_CODE
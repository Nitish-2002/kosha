PORT=3000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgres://kosha:kosha@localhost:5432/kosha
# Optional — Postgres connection pool size. Defaults to 30.
DB_POOL_SIZE=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# 64 hex characters (32 bytes) — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# Optional — best-effort. Access-request notifications skip Chat entirely if unset.
GOOGLE_CHAT_WEBHOOK_URL=
